# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: absolute site URL for OAuth redirects in odd hosting setups
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vertex AI / Gemini (resume analysis)
GCP_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-flash
# For GCP credentials on Vercel, use JSON string or default ADC

# Razorpay (optional; test mode if unset)
NEXT_PUBLIC_RZP_KEY_ID=
RZP_KEY_ID=
RZP_KEY_SECRET=
